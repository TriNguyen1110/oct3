ANTHROPIC_API_KEY=
# Optional short audio-to-mission drafting; server-only, never a public key.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional administrative connection, used only to apply checked-in migrations.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SURFSKY_API_KEY=
BROWSERLESS_TOKEN=
SURFSKY_API_BASE_URL=
SURFSKY_PROXY_COUNTRY=us
STRIPE_SECRET_KEY=
STRIPE_PROFILE_ID=
MPP_SECRET_KEY=
# Explicit sandbox rehearsal helper; accepts only Stripe test keys/profiles.
OCT3_TEST_PAYMENT_ENABLED=false
OCT3_AGENT_TOKEN=
OCT3_MANAGER_TOKEN=
# Fixture mode is visibly labeled and never claims a real merchant purchase.
# Off by default. true makes new missions default to fixtures and exposes the MCP
# confirm_and_execute tool. It never approves a live mission: live actions always
# need the manager's passkey on the mission board, whatever this flag says.
OCT3_DEMO_MODE=false

# Per-installation policy (approvers, spend limit, merchants, food stores, defaults).
# Copy config/installation-policy.example.json to .cue/policy.json and edit it, or
# point OCT3_POLICY_FILE at your copy. OCT3_POLICY_SOURCE=willder selects the Willder
# source (not connected yet). Without a valid policy, live approvals, wallet requests
# and the food worker refuse.
OCT3_POLICY_FILE=

# Public origin used in dashboard/review links (never include an access token).
# Use localhost for native passkeys; WebAuthn RP IDs cannot be IP addresses.
OCT3_APP_URL=http://localhost:3003

# Link wallet: server-only. Default test mode cannot fund real merchant purchases.
LINK_ACCESS_TOKEN=
# Local only: isolated owner-only CLI auth file; never deploy a local path.
LINK_AUTH_FILE=
OCT3_LINK_MODE=test
