  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.46",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@supabase/supabase-js": "2.117.2",
    "ai": "7.0.58",
    "eve": "0.47.3",
    "mcp-handler": "2.2.0",
    "mppx": "0.13.1",
    "next": "16.3.8",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "23.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
