{
  "name": "oct3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3003",
    "build": "eve build && next build",
    "start": "next start --hostname 127.0.0.1 --port 3003",
    "typecheck": "tsc --noEmit",
